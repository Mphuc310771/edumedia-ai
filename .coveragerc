[run]
source = apps, pipeline
omit =
    tests/*
    config/*
    */__init__.py
    venv/*
    .env

[report]
show_missing = True
fail_under = 80
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
