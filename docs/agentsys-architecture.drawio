        <!-- ========================================================================= -->
        <!-- AWS WELL-ARCHITECTED 5-PILLAR GOVERNANCE & SECURITY FOUNDATION FOOTER      -->
        <!-- Container Box (x = 25, y = 902, w = 1990, h = 95)                         -->
        <!-- ========================================================================= -->
        <mxCell id="u_box_pillars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Helvetica;fontColor=#0F172A;" value="" vertex="1">
          <mxGeometry height="95" width="1990" x="25" y="902" as="geometry" />
        </mxCell>
        <mxCell id="u_badge_pillars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;fontColor=#FFFFFF;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b&gt;AWS Well-Architected Framework: 5-Pillar Review&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="620" x="40" y="894" as="geometry" />
        </mxCell>

        <!-- Column 1: Security -->
        <mxCell id="u_pillar_sec" parent="1" style="text;html=1;strokeColor=none;fillColor=#FEF2F2;rounded=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=8.5;fontColor=#991B1B;padding=6;" value="&lt;b style=&quot;font-size:9.5px; color:#B91C1C;&quot;&gt;1. Security&lt;/b&gt;&lt;br&gt;• Least-Privilege IAM Scoped Roles (ApiFunction, IngestFunction, AggregatorFunction)&lt;br&gt;• S3 Block All Public Access · SSE-S3 AES-256 · SQS-SSE · DynamoDB SSE · SNS KMS-SSE&lt;br&gt;• Scoped API-Key &amp;amp; JWT Bearer Token Validation · SigV4 IAM Execution Auth&lt;br&gt;• HTTPS TLS 1.2+ end-to-end · S3 Presigned URLs · PUT: 900s / GET: 3600s" vertex="1">
          <mxGeometry height="68" width="380" x="35" y="920" as="geometry" />
        </mxCell>

        <!-- Column 2: Reliability -->
        <mxCell id="u_pillar_rel" parent="1" style="text;html=1;strokeColor=none;fillColor=#EFF6FF;rounded=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=8.5;fontColor=#1E40AF;padding=6;" value="&lt;b style=&quot;font-size:9.5px; color:#1D4ED8;&quot;&gt;2. Reliability&lt;/b&gt;&lt;br&gt;• 3-Level Isolated DLQ Topology: Ingest DLQ, Stream DLQ &amp;amp; EventBridge Target DLQ&lt;br&gt;• Multi-AZ Serverless HA (S3, DynamoDB, SQS, Lambda, Bedrock)&lt;br&gt;• ReportBatchItemFailures (Partial batch retry without blocking queue)&lt;br&gt;• DynamoDB Streams BisectBatchOnFunctionError isolates poisoned records" vertex="1">
          <mxGeometry height="68" width="380" x="430" y="920" as="geometry" />
        </mxCell>

        <!-- Column 3: Performance -->
        <mxCell id="u_pillar_perf" parent="1" style="text;html=1;strokeColor=none;fillColor=#F0FDF4;rounded=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=8.5;fontColor=#166534;padding=6;" value="&lt;b style=&quot;font-size:9.5px; color:#15803D;&quot;&gt;3. Performance Efficiency&lt;/b&gt;&lt;br&gt;• Direct S3 Presigned PUT: Bypasses APIGW 10MB payload &amp;amp; timeout limits&lt;br&gt;• Titan v2 256-d Embeddings: 75% storage reduction vs native 1024-d&lt;br&gt;• In-Memory Hybrid Ranker: Zero network I/O overhead (In-Process RAM)&lt;br&gt;• DynamoDB GSI category-index: PK &amp;amp; GSI Query + Bounded Scan Fallback (100 Capped Candidates)" vertex="1">
          <mxGeometry height="68" width="380" x="825" y="920" as="geometry" />
        </mxCell>

        <!-- Column 4: Cost Optimization -->
        <mxCell id="u_pillar_cost" parent="1" style="text;html=1;strokeColor=none;fillColor=#FFFBEB;rounded=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=8.5;fontColor=#92400E;padding=6;" value="&lt;b style=&quot;font-size:9.5px; color:#B45309;&quot;&gt;4. Cost Optimization (FinOps)&lt;/b&gt;&lt;br&gt;• 100% Serverless Pay-as-you-go: Scale-to-Zero compute (idle cost = storage + logs only)&lt;br&gt;• DynamoDB PAY_PER_REQUEST: Zero provisioned idle capacity waste&lt;br&gt;• S3 Lifecycle: Auto-expires temporary transcripts/ after 7 days&lt;br&gt;• CloudWatch Log Retention: 14 Days (Prevents runaway logging costs)&lt;br&gt;• Amazon Nova Lite Default: 10x-20x cheaper token cost vs Claude Sonnet" vertex="1">
          <mxGeometry height="68" width="380" x="1220" y="920" as="geometry" />
        </mxCell>

        <!-- Column 5: Operational Excellence -->
        <mxCell id="u_pillar_ops" parent="1" style="text;html=1;strokeColor=none;fillColor=#FAF5FF;rounded=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=8.5;fontColor=#6B21A8;padding=6;" value="&lt;b style=&quot;font-size:9.5px; color:#7C3AED;&quot;&gt;5. Operational Excellence&lt;/b&gt;&lt;br&gt;• Infrastructure as Code (IaC): 100% declarative AWS SAM template.yaml&lt;br&gt;• AWS X-Ray Active Distributed Tracing across all Lambda orchestrations&lt;br&gt;• 7 SAM-Managed CloudWatch Alarms &amp;gt; Amazon SNS agentsys-alerts-topic&lt;br&gt;• Standardized Key-Value Structured Logging (X-Ray Distributed Tracing · CloudWatch Insights Ready)" vertex="1">
          <mxGeometry height="68" width="380" x="1615" y="920" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
