# AgentSys SAM config example
# Copy to samconfig.toml and replace values. Do not commit secrets.

version = 0.1
[default.deploy.parameters]
stack_name = "agentsys"
resolve_s3 = true
s3_prefix = "agentsys"
region = "us-east-1"
capabilities = "CAPABILITY_IAM"
parameter_overrides = "ApiKey=replace-me BedrockModelId=amazon.nova-lite-v1:0 BedrockRegion=us-east-1"
confirm_changeset = true
