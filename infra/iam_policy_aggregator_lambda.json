{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBStreamAndTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/AgentSysMediaMetadata",
        "arn:aws:dynamodb:us-east-1:*:table/AgentSysMediaMetadata/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/AgentSysMediaMetadata/stream/*"
      ]
    },
    {
      "Sid": "DynamoDBListStreamsGlobal",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockInvocation",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-1:*:inference-profile/*"
      ]
    },
    {
      "Sid": "SQSStreamDLQAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:*:agentsys-aggregator-stream-dlq"
      ]
    },
    {
      "Sid": "CustomMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AgentSys"
        }
      }
    },
    {
      "Sid": "CloudWatchLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:*:log-group:/aws/lambda/agentsys-aggregator:*"
      ]
    }
  ]
}
