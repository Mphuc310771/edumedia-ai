FROM node:20-alpine AS builder

WORKDIR /app
COPY gallery_web/package*.json ./
RUN npm ci || npm install
COPY gallery_web/ .
ARG VITE_API_BASE=
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginx:alpine
COPY gallery_web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
