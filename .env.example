# AgentSys Environment Configuration Template
DEBUG=false
ENVIRONMENT=development
ADMIN_API_KEY=local-dev-key

# memory = local catalog (CI / laptop). aws = real AWS services.
MEDIA_PROVIDER=memory
SEED_DEMO_ITEMS=true

# Used when MEDIA_PROVIDER=aws
AWS_REGION=us-east-1
MEDIA_BUCKET=agentsys-media-bucket
METADATA_TABLE=AgentSysMediaMetadata
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1
CLOUDWATCH_NAMESPACE=AgentSys

# Optional: only if you are not using an IAM role / `aws configure`
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
