# AgentSys Environment Configuration Template
# Copy to `.env` locally. Never commit `.env`.
DEBUG=false
ENVIRONMENT=development
ADMIN_API_KEY=change-me
ADMIN_USERNAME=admin
# Optional. Empty = login password is ADMIN_API_KEY
# ADMIN_PASSWORD=

AWS_REGION=us-east-1
MEDIA_BUCKET=agentsys-media-bucket
METADATA_TABLE=AgentSysMediaMetadata
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1
CLOUDWATCH_NAMESPACE=AgentSys

# Optional: Override CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Frontend only: API base URL for Vite build (empty = same origin via proxy)
# VITE_API_BASE=

# Do not put real AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in git or chat.
# Local: `aws configure`. Lambda/EC2: IAM role. boto3 picks credentials up automatically.
